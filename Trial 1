<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DVD Screensaver with Playlist</title>
    <style>
        body {
            margin: 0;
            background-color: black;
            color: white;
            font-family: Arial, sans-serif;
            overflow: hidden;
            position: relative;
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .screensaver {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 100px;
            height: 50px;
            background-color: red;
            border-radius: 10px;
            transform: translate(-50%, -50%);
            animation: move 5s linear infinite;
        }

        @keyframes move {
            0% { transform: translate(0, 0); }
            25% { transform: translate(calc(100vw - 100px), 0); }
            50% { transform: translate(calc(100vw - 100px), calc(100vh - 50px)); }
            75% { transform: translate(0, calc(100vh - 50px)); }
            100% { transform: translate(0, 0); }
        }

        .sentence {
            position: absolute;
            top: 10%;
            width: 100%;
            text-align: center;
            font-size: 1.5rem;
        }

        .playlist {
            position: absolute;
            bottom: 10%;
            width: 100%;
            text-align: center;
        }

        .playlist input {
            display: block;
            margin: 0.5rem auto;
        }
    </style>
</head>
<body>
    <div class="screensaver"></div>

    <div class="sentence">This is a 20-word sentence that will remain visible in the background while the DVD screensaver is running.</div>

    <div class="playlist">
        <h2>Playlist</h2>
        <input type="file" id="songInput" accept="audio/*" multiple>
        <div id="playlist"></div>
        <audio id="audioPlayer" controls></audio>
    </div>

    <script>
        const songInput = document.getElementById('songInput');
        const playlist = document.getElementById('playlist');
        const audioPlayer = document.getElementById('audioPlayer');

        songInput.addEventListener('change', (event) => {
            playlist.innerHTML = ''; // Clear existing playlist
            const files = event.target.files;
            Array.from(files).forEach((file, index) => {
                const songItem = document.createElement('div');
                songItem.textContent = file.name;
                songItem.style.cursor = 'pointer';
                songItem.style.color = 'cyan';
                songItem.addEventListener('click', () => {
                    const fileURL = URL.createObjectURL(file);
                    audioPlayer.src = fileURL;
                    audioPlayer.play();
                });
                playlist.appendChild(songItem);
            });
        });
    </script>
</body>
</html>
